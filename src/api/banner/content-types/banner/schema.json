{
  "kind": "collectionType",
  "collectionName": "banners",
  "info": {
    "singularName": "banner",
    "pluralName": "banners",
    "displayName": "Banner",
    "description": "Home page hero slides and promo tiles"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "placement": {
      "type": "enumeration",
      "enum": [
        "hero",
        "promo"
      ],
      "default": "hero",
      "required": true
    },
    "eyebrow": {
      "type": "string"
    },
    "title": {
      "type": "string",
      "required": true
    },
    "subtitle": {
      "type": "text"
    },
    "ctaLabel": {
      "type": "string",
      "required": true,
      "default": "Shop now"
    },
    "ctaHref": {
      "type": "string",
      "required": true,
      "default": "/shop"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "required": true,
      "allowedTypes": [
        "images"
      ]
    },
    "theme": {
      "type": "enumeration",
      "enum": [
        "primary",
        "dark",
        "accent"
      ],
      "default": "primary"
    },
    "sortOrder": {
      "type": "integer",
      "default": 0
    }
  }
}
