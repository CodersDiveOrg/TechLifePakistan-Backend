# Copy to .env and fill in. Generate every secret below with:
#   node -e "console.log(require('crypto').randomBytes(16).toString('base64'))"
# Use NEW secrets in production — never reuse the local ones.

HOST=0.0.0.0
PORT=1337
# Public URL of this Strapi server when behind Nginx, e.g. https://admin.yourstore.pk
PUBLIC_URL=
# true when running behind Nginx / a reverse proxy
IS_PROXIED=false

# Secrets
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Database (docker-compose.yml reads the same values)
DATABASE_CLIENT=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=5434
DATABASE_NAME=techlifepakistan
DATABASE_USERNAME=techlifepakistan
DATABASE_PASSWORD=change-me
DATABASE_SSL=false

# Storefront (Next.js)
CORS_ORIGINS=http://localhost:3000
STOREFRONT_URL=http://localhost:3000
# Same value as REVALIDATE_SECRET in the storefront's .env.local
REVALIDATE_SECRET=change-me

# Email — local: Mailpit (http://localhost:8025). Hostinger mail: smtp.hostinger.com, 465, SMTP_SECURE=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
SMTP_SECURE=false
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=Tech Life Pakistan <orders@techlifepakistan.pk>
EMAIL_REPLY_TO=sales@techlifepakistan.pk
# Where new-order / payment alerts go (defaults to the Store settings email)
STORE_NOTIFY_EMAIL=

# Rate limiting (optional)
RATE_LIMIT_PER_MINUTE=120
RATE_LIMIT_GRAPHQL_PER_MINUTE=60
# Comma-separated IPs that skip the limit — the storefront server's IP(s)
RATE_LIMIT_ALLOW_IPS=127.0.0.1,::1,::ffff:127.0.0.1
